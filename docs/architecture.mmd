classDiagram
    class City {
        -Long id
        -String name
        -double latitude
        -double longitude
        -String region
        -int population
    }

    class CityRepository {
        <<interface>>
        +findAll() List~City~
    }

    class CityService {
        <<interface>>
        +findNearbyCities(...) List~CityResponseDTO~
    }

    class CityServiceImpl {
        -CityRepository repository
        -DistanceCalculator calculator
    }

    class CityResponseDTO {
        -String name
        -int distance
        -City city
    }

%% Relations avec noms de variables (rôles) et cardinalités

%% Le repository contient la collection de villes
    CityRepository "1" --> "*" City : cities

%% L'implémentation du service possède une instance du repository
    CityServiceImpl "1" --> "1" CityRepository : repository

%% Le service produit/utilise des DTOs (souvent gérés en liste dans les méthodes)
    CityServiceImpl "1" ..> "*" CityResponseDTO : results

%% Le DTO contient une référence à l'objet City original (pour les détails au survol)
    CityResponseDTO "*" --> "1" City : city

%% Relation d'héritage/implémentation (pas de variable ici)
    CityServiceImpl ..|> CityService